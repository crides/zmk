if BOARD_FISSURE_LEFT || BOARD_FISSURE_RIGHT

config ZMK_KEYBOARD_NAME
	default "Fissure v3.3"

config SOC_DCDC_NRF52X_HV
    default y

if USB

config USB_NRFX
	default y

config USB_DEVICE_STACK
	default y

endif # USB

config BT_CTLR
	default BT

config ZMK_BLE
	default y

config ZMK_USB
	default y if BOARD_FISSURE_RIGHT

config ZMK_BATTERY_VOLTAGE_DIVIDER
	default y

if ZMK_MOUSE
config INPUT
    default y
endif

config RTT_LOG
    bool "RTT logging"
    select LOG
    select CONSOLE
    select USE_SEGGER_RTT
    select RTT_CONSOLE

if RTT_LOG
config LOG_BACKEND_RTT_OUTPUT_BUFFER_SIZE
    default 128
config LOG_BUFFER_SIZE
    default 8192
endif

rsource "../../../steno/Kconfig"

endif
